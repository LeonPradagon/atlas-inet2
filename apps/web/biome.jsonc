{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "../../biome.jsonc",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "root": false,
  "linter": {
    "rules": {
      "suspicious": {
        // Not type-aware: flags plain booleans too. All 58 hits were false positives
        // (no numeric left operand that could render a stray 0).
        "noLeakedRender": "off"
      }
    }
  }
}
